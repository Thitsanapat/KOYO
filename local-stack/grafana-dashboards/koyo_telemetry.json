      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "koyo-influxdb"
          },
          "query": "from(bucket: \"koyo_telemetry\")\n  |> range(start: -400d)\n  |> filter(fn: (r) => r._measurement == \"beacon\" and r.channel == \"Obc time\")\n  |> filter(fn: (r) => r._field == \"value\")\n  |> group(columns: [\"channel\"])\n  |> sort(columns: [\"_time\"])\n  |> last()\n  |> map(fn: (r) => ({r with _value: float(v: r._value) * 1000.0}))\n  |> keep(columns: [\"_time\", \"_value\"])\n  |> rename(columns: {_value: \"Latest Measurement (UTC)\"})"
        }
      ],
